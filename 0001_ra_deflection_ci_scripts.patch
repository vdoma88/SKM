diff --git a/scripts/apply_patch.ps1 b/scripts/apply_patch.ps1
new file mode 100644
--- /dev/null
+++ b/scripts/apply_patch.ps1
@@ -0,0 +1,51 @@
+param(
+    [Parameter(Mandatory = $true)]
+    [string]$PatchFile,
+
+    [string]$CommitMessage = "",
+
+    [switch]$Push
+)
+
+$ErrorActionPreference = "Stop"
+
+if (-not (Test-Path $PatchFile)) {
+    Write-Error "Файл патча не найден: $PatchFile"
+    exit 1
+}
+
+Write-Host "[1/4] Проверка применимости патча..." -ForegroundColor Cyan
+git apply --check --ignore-space-change --ignore-whitespace $PatchFile
+
+Write-Host "[2/4] Применение патча..." -ForegroundColor Cyan
+git apply --ignore-space-change --ignore-whitespace $PatchFile
+
+Write-Host "[3/4] Запуск тестов (pytest)..." -ForegroundColor Cyan
+if (Test-Path ".\.venv\Scripts\pytest.exe") {
+    & .\.venv\Scripts\pytest.exe -v
+} elseif (Get-Command pytest -ErrorAction SilentlyContinue) {
+    pytest -v
+} else {
+    python tests/test_engine.py
+}
+
+if ($LASTEXITCODE -ne 0) {
+    Write-Error "Тесты не пройдены. Коммит отменён."
+    exit $LASTEXITCODE
+}
+
+Write-Host "[4/4] Git статус:" -ForegroundColor Green
+git status -s
+
+if ($CommitMessage -ne "") {
+    git add -A
+    git commit -m $CommitMessage
+    if ($Push) {
+        git push origin main
+        Write-Host "Изменения отправлены в origin/main." -ForegroundColor Green
+    } else {
+        Write-Host "Коммит создан. Для отправки выполните: git push origin main" -ForegroundColor Yellow
+    }
+} else {
+    Write-Host "Патч применён и тесты пройдены. Чтобы закоммитить и запушить одной командой, передайте -CommitMessage '...' -Push" -ForegroundColor Yellow
+}
diff --git a/scripts/apply_patch.sh b/scripts/apply_patch.sh
new file mode 100755
--- /dev/null
+++ b/scripts/apply_patch.sh
@@ -0,0 +1,45 @@
+#!/usr/bin/env bash
+set -euo pipefail
+
+if [ $# -lt 1 ]; then
+  echo "Usage: ./scripts/apply_patch.sh <file.patch> [commit_message] [--push]"
+  exit 1
+fi
+
+PATCH_FILE="$1"
+COMMIT_MSG="${2:-}"
+DO_PUSH="${3:-}"
+
+if [ ! -f "$PATCH_FILE" ]; then
+  echo "Patch file not found: $PATCH_FILE"
+  exit 1
+fi
+
+echo "[1/4] Checking patch..."
+git apply --check --ignore-space-change --ignore-whitespace "$PATCH_FILE"
+
+echo "[2/4] Applying patch..."
+git apply --ignore-space-change --ignore-whitespace "$PATCH_FILE"
+
+echo "[3/4] Running tests..."
+if [ -x "./.venv/bin/pytest" ]; then
+  ./.venv/bin/pytest -v
+elif command -v pytest >/dev/null 2>&1; then
+  pytest -v
+else
+  python3 tests/test_engine.py
+fi
+
+echo "[4/4] Git status:"
+git status -s
+
+if [ -n "$COMMIT_MSG" ]; then
+  git add -A
+  git commit -m "$COMMIT_MSG"
+  if [ "$DO_PUSH" = "--push" ]; then
+    git push origin main
+    echo "Pushed to origin/main."
+  else
+    echo "Committed. Run 'git push origin main' to publish."
+  fi
+fi
